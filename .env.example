# Vectiq secrets. Copy to .env (install.sh does this) and keep it private: it holds the bot's account key.
VECTOR_NSEC=
# Space-separated invite links the bot joins once on first start (optional).
VECTIQ_INVITE_URLS=
# Where the SQLite database and the bot's identity live (default ./data).
VECTIQ_DATA_DIR=data
# Optional: protects POST /admin/webhooks when webhooks.server.enabled is true in config.yaml.
WEBHOOKS_ADMIN_KEY=
